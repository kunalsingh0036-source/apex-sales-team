{
  "manifest_version": 3,
  "name": "Apex Lead Capture",
  "version": "0.1.0",
  "description": "Capture leads from FHRAI, schools.org.in, GeM tenders, and LinkedIn into the Apex outreach agent.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Capture this page to Apex"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.fhrai.com/*",
    "https://schools.org.in/*",
    "https://bidplus.gem.gov.in/*",
    "https://www.linkedin.com/*",
    "https://apex-sales-team-production-2c45.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.fhrai.com/*"],
      "js": ["content/common.js", "content/fhrai.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://schools.org.in/*"],
      "js": ["content/common.js", "content/schools.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bidplus.gem.gov.in/*"],
      "js": ["content/common.js", "content/gem.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/common.js", "content/linkedin.js"],
      "run_at": "document_idle"
    }
  ]
}
